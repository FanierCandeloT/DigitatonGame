  m_Script: {fileID: 11500000, guid: f6f67c46db390fc409272bfe991e710e, type: 3}
  m_Name: TutorialBook
  m_EditorClassIdentifier: Assembly-CSharp::TutorialBookAsset
  pages:
  - leftTitle: What is the Passive Voice?
    leftBody: We use it when the action is more important than who does it.
    rightTitle: 
    rightBody: '<b>Active:</b>

      "The students recycle paper."


      <b>Passive:</b>

      "Paper is recycled by the students."'
  - leftTitle: The formula
    leftBody: Object + BE + past participle (+ by + who does it)
    rightTitle: 
    rightBody: '"Solar panels are installed by engineers."


      BE changes with the tense.

      The participle never changes.'
  - leftTitle: Tenses (1)
    leftBody: '<b>Present:</b> is/are + PP

      -> "Classes are taught here."


      <b>Past:</b> was/were + PP

      -> "The panels were installed."'
    rightTitle: Tenses (2)
    rightBody: '<b>Present continuous:</b> is/are being + PP


      <b>Present perfect:</b> has/have been + PP


      <b>Future:</b> will be + PP


      <b>Modals:</b> can/must be + PP'
  - leftTitle: Active to Passive in 3 steps
    leftBody: '1. Move the object to the front.

      2. Add BE in the same tense.

      3. Use the past participle.'
    rightTitle: 
    rightBody: '"The university recycles paper."

      ->

      "Paper is recycled by the university."'
  - leftTitle: Common mistakes
    leftBody: '"The bins was emptied."

      -> "were emptied"


      "Workers will paid."

      -> "will be paid"


      "teached"

      -> "taught"'
    rightTitle: Ready?
    rightBody: You can read this again anytime in your Professor's Notebook. Press C during the game!
