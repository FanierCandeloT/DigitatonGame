  memoryReward: 2
  requiredChallenge: r3_exams
  intro:
  - speaker: "Andr\xE9s"
    text: Good morning, class! Today we are practicing the passive voice.
    spanish: 
    mixed: 
    fluent: 0
  - speaker: Valentina
    text: Professor, the sentences will be read by us, right?
    spanish: 
    mixed: 
    fluent: 0
  - speaker: "Andr\xE9s"
    text: Exactly! Listen carefully. If a sentence has a mistake, you must stop it.
    spanish: 
    mixed: 
    fluent: 0
  passed:
  - speaker: Valentina
    text: Great class, professor! The mistakes were found by everyone.
    spanish: 
    mixed: 
    fluent: 0
  - speaker: "Andr\xE9s"
    text: Well done, everybody. See you tomorrow.
    spanish: 
    mixed: 
    fluent: 0
  doneMessage: The lesson is over. Good work, professor!
